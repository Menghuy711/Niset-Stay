# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=niset_stay
DB_USER=root
DB_PASSWORD=

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Set to false in production to disable dev-only helpers (e.g. reset_token in response)
DEBUG=true

# Comma-separated list of allowed CORS origins
# Production: ALLOWED_ORIGINS=https://yourdomain.github.io
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Number of reverse-proxy hops in front of the API (production only). Only
# relevant when behind Cloudflare/Nginx: rate limiters key on the real client
# IP, which requires trusting the proxy hop count.
# TRUST_PROXY_HOPS=1

# Public URL used to build password-reset links emailed to users.
# Example: https://your-org.github.io/Niset-Stay
PUBLIC_APP_URL=http://localhost:5173/Niset-Stay

# Optional SMTP transport for password-reset emails.
# When unset (or MAIL_USER missing) the reset link is printed to the server
# log instead of emailed, so the flow never silently drops the token.
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_SECURE=false
# MAIL_USER=no-reply@example.com
# MAIL_PASSWORD=your-smtp-password
# MAIL_FROM=no-reply@example.com